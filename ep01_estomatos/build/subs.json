[
{
"t0": 0.22,
"t1": 1.16,
"text": "Você sabia que uma"
},
{
"t0": 1.16,
"t1": 2.48,
"text": "única folha pode esconder"
},
{
"t0": 2.48,
"t1": 4.21,
"text": "milhares de pequenas bocas?"
},
{
"t0": 4.21,
"t1": 5.11,
"text": "E que elas ajudam a"
},
{
"t0": 5.11,
"t1": 6.78,
"text": "manter a planta viva?"
},
{
"t0": 7.42,
"t1": 8.7,
"text": "Essas pequenas estruturas"
},
{
"t0": 8.7,
"t1": 10.33,
"text": "são chamadas de estômatos."
},
{
"t0": 10.33,
"t1": 11.5,
"text": "Elas são microscópicas"
},
{
"t0": 11.5,
"t1": 12.98,
"text": "e funcionam como verdadeiras"
},
{
"t0": 12.98,
"t1": 14.09,
"text": "portas de comunicação"
},
{
"t0": 14.09,
"t1": 15.05,
"text": "entre a planta e o"
},
{
"t0": 15.05,
"t1": 16.24,
"text": "ambiente."
},
{
"t0": 17.62,
"t1": 18.52,
"text": "Quando os estômatos"
},
{
"t0": 18.52,
"t1": 19.22,
"text": "se abrem,"
},
{
"t0": 19.22,
"t1": 20.35,
"text": "o gás carbônico consegue"
},
{
"t0": 20.35,
"t1": 21.39,
"text": "entrar na folha."
},
{
"t0": 21.39,
"t1": 22.31,
"text": "Com água e energia"
},
{
"t0": 22.31,
"t1": 23.28,
"text": "da luz solar,"
},
{
"t0": 23.28,
"t1": 24.36,
"text": "a planta utiliza esse"
},
{
"t0": 24.36,
"t1": 25.69,
"text": "gás para produzir açúcares"
},
{
"t0": 25.69,
"t1": 27.619999999999997,
"text": "através da fotossíntese."
},
{
"t0": 29.52,
"t1": 30.58,
"text": "Mas não é só isso!"
},
{
"t0": 30.58,
"t1": 31.79,
"text": "Pelos estômatos também"
},
{
"t0": 31.79,
"t1": 32.84,
"text": "podem sair oxigênio"
},
{
"t0": 32.84,
"t1": 34.05,
"text": "e vapor de água."
},
{
"t0": 34.05,
"t1": 35.15,
"text": "Esse processo de perda"
},
{
"t0": 35.15,
"t1": 36.16,
"text": "de água é chamado de"
},
{
"t0": 36.16,
"t1": 37.16,
"text": "transpiração e ajuda"
},
{
"t0": 37.16,
"t1": 38.32,
"text": "a regular a temperatura"
},
{
"t0": 38.32,
"t1": 39.519999999999996,
"text": "da planta."
},
{
"t0": 40.62,
"t1": 41.65,
"text": "E como essas pequenas"
},
{
"t0": 41.65,
"t1": 42.73,
"text": "portas conseguem abrir"
},
{
"t0": 42.73,
"t1": 43.47,
"text": "e fechar?"
},
{
"t0": 43.47,
"t1": 44.48,
"text": "Tudo acontece graças"
},
{
"t0": 44.48,
"t1": 45.69,
"text": "às células-guarda,"
},
{
"t0": 45.69,
"t1": 46.86,
"text": "que alteram sua pressão"
},
{
"t0": 46.86,
"t1": 48.02,
"text": "interna conforme ganham"
},
{
"t0": 48.02,
"t1": 49.48,
"text": "ou perdem água."
},
{
"t0": 51.42,
"t1": 52.5,
"text": "Quando falta água,"
},
{
"t0": 52.5,
"t1": 53.48,
"text": "sinais químicos,"
},
{
"t0": 53.48,
"t1": 54.78,
"text": "como o ácido abscísico,"
},
{
"t0": 54.78,
"t1": 55.59,
"text": "ajudam a fechar os"
},
{
"t0": 55.59,
"t1": 56.31,
"text": "estômatos."
},
{
"t0": 56.31,
"t1": 57.17,
"text": "Isso reduz a perda"
},
{
"t0": 57.17,
"t1": 57.83,
"text": "de água,"
},
{
"t0": 57.83,
"t1": 58.93,
"text": "mas também pode limitar"
},
{
"t0": 58.93,
"t1": 59.79,
"text": "a fotossíntese e o"
},
{
"t0": 59.79,
"t1": 61.519999999999996,
"text": "crescimento da planta."
},
{
"t0": 63.32,
"t1": 64.14,
"text": "Na agricultura,"
},
{
"t0": 64.14,
"t1": 65.23,
"text": "esse equilíbrio microscópico"
},
{
"t0": 65.23,
"t1": 66.32,
"text": "pode influenciar diretamente"
},
{
"t0": 66.32,
"t1": 67.13,
"text": "o desenvolvimento das"
},
{
"t0": 67.13,
"t1": 68.3,
"text": "culturas e até a produtividade"
},
{
"t0": 68.3,
"t1": 69.52000000000001,
"text": "de uma lavoura."
},
{
"t0": 70.62,
"t1": 71.89,
"text": "O agro esconde um universo"
},
{
"t0": 71.89,
"t1": 72.67,
"text": "invisível."
},
{
"t0": 72.67,
"t1": 74.1,
"text": "Siga para descobrir mais!"
}
]