[
{
"t0": 0.23,
"t1": 1.19,
"text": "Você sabia que cada"
},
{
"t0": 1.19,
"t1": 2.3,
"text": "fio do cabelo do milho"
},
{
"t0": 2.3,
"t1": 4.17,
"text": "está ligado a um possível grão?"
},
{
"t0": 4.17,
"t1": 5.3,
"text": "E que sem fecundação"
},
{
"t0": 5.3,
"t1": 7.3,
"text": "esse grão não se forma?"
},
{
"t0": 7.3,
"t1": 8.85,
"text": "Esses fios são chamados"
},
{
"t0": 8.85,
"t1": 10.6,
"text": "de estilos-estigmas."
},
{
"t0": 10.6,
"t1": 11.85,
"text": "Cada um está ligado"
},
{
"t0": 11.85,
"t1": 13.03,
"text": "a um ovário com um"
},
{
"t0": 13.03,
"t1": 14.21,
"text": "óvulo e possui uma"
},
{
"t0": 14.21,
"t1": 15.45,
"text": "função essencial na"
},
{
"t0": 15.45,
"t1": 17.56,
"text": "reprodução do milho."
},
{
"t0": 17.75,
"t1": 19.04,
"text": "No alto da planta está"
},
{
"t0": 19.04,
"t1": 19.92,
"text": "o pendão,"
},
{
"t0": 19.92,
"t1": 21.38,
"text": "responsável pela produção"
},
{
"t0": 21.38,
"t1": 22.26,
"text": "do pólen."
},
{
"t0": 22.26,
"t1": 23.86,
"text": "Transportados principalmente"
},
{
"t0": 23.86,
"t1": 24.83,
"text": "pelo vento,"
},
{
"t0": 24.83,
"t1": 25.97,
"text": "esses pequenos grãos"
},
{
"t0": 25.97,
"t1": 27.11,
"text": "precisam alcançar os"
},
{
"t0": 27.11,
"t1": 28.14,
"text": "cabelos receptivos"
},
{
"t0": 28.14,
"t1": 29.41,
"text": "das espigas."
},
{
"t0": 29.41,
"t1": 30.77,
"text": "Ao encontrar um cabelo"
},
{
"t0": 30.77,
"t1": 31.76,
"text": "receptivo,"
},
{
"t0": 31.76,
"t1": 33.19,
"text": "o pólen germina e forma"
},
{
"t0": 33.19,
"t1": 34.55,
"text": "o tubo polínico,"
},
{
"t0": 34.55,
"t1": 36.04,
"text": "uma estrutura que cresce"
},
{
"t0": 36.04,
"t1": 37.46,
"text": "pelo interior do estilo"
},
{
"t0": 37.46,
"t1": 39.47,
"text": "em direção ao óvulo."
},
{
"t0": 40.65,
"t1": 41.79,
"text": "É nesse momento que"
},
{
"t0": 41.79,
"t1": 43.82,
"text": "acontece a dupla fecundação,"
},
{
"t0": 43.82,
"t1": 45.19,
"text": "dando início à formação"
},
{
"t0": 45.19,
"t1": 47.17,
"text": "do embrião e do endosperma,"
},
{
"t0": 47.17,
"t1": 48.24,
"text": "tecido responsável"
},
{
"t0": 48.24,
"t1": 49.56,
"text": "por armazenar reservas"
},
{
"t0": 49.56,
"t1": 51.42,
"text": "para a futura planta."
},
{
"t0": 51.42,
"t1": 52.56,
"text": "Quando a seca ou o"
},
{
"t0": 52.56,
"t1": 53.69,
"text": "calor prejudicam a"
},
{
"t0": 53.69,
"t1": 55.77,
"text": "polinização e a fecundação,"
},
{
"t0": 55.77,
"t1": 56.91,
"text": "alguns grãos podem"
},
{
"t0": 56.91,
"t1": 58.17,
"text": "não se formar."
},
{
"t0": 58.17,
"t1": 59.53,
"text": "O abortamento de grãos"
},
{
"t0": 59.53,
"t1": 60.77,
"text": "já fecundados também"
},
{
"t0": 60.77,
"t1": 62.01,
"text": "pode provocar falhas"
},
{
"t0": 62.01,
"t1": 63.3,
"text": "na espiga."
},
{
"t0": 63.3,
"t1": 64.31,
"text": "Na agricultura,"
},
{
"t0": 64.31,
"t1": 65.56,
"text": "esse processo microscópico"
},
{
"t0": 65.56,
"t1": 66.53,
"text": "é fundamental,"
},
{
"t0": 66.53,
"t1": 67.82,
"text": "pois influencia diretamente"
},
{
"t0": 67.82,
"t1": 68.74,
"text": "o número de grãos e"
},
{
"t0": 68.74,
"t1": 69.61,
"text": "a produtividade da"
},
{
"t0": 69.61,
"t1": 70.68,
"text": "lavoura."
},
{
"t0": 70.7,
"t1": 71.67,
"text": "Nunca mais olhe para"
},
{
"t0": 71.67,
"t1": 72.64,
"text": "o cabelo do milho da"
},
{
"t0": 72.64,
"t1": 73.52,
"text": "mesma forma!"
}
]